@startuml
title C4 Level 2 - Graph Search System
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor User

rectangle "Graph Search System" {
    component "Input / Main Program" as Input
    component "Graph Data Model" as Graph
    component "BFS Function" as BFS
    component "DFS Function" as DFS
    component "Timing Function\nmeasure()" as Timer
    component "Result Output" as Output
}

User --> Input : Start, goal
Input --> Graph : Read graph
Input --> BFS : Execute BFS
Input --> DFS : Execute DFS
BFS --> Output : Path and expanded count
DFS --> Output : Path and expanded count
Timer --> BFS : Measure runtime
Timer --> DFS : Measure runtime
Output --> User : Display results

@enduml